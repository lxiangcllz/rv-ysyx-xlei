top=keyboard_top

rst_n SW0
ps2_clk PS2_CLK
ps2_data PS2_DAT
overflow LD0
key_valid LD1

# SEG0 在最右。低两位键码、中间 ASCII、高两位次数
hex[0] (SEG0G, SEG0F, SEG0E, SEG0D, SEG0C, SEG0B, SEG0A)
hex[1] (SEG1G, SEG1F, SEG1E, SEG1D, SEG1C, SEG1B, SEG1A)
hex[2] (SEG2G, SEG2F, SEG2E, SEG2D, SEG2C, SEG2B, SEG2A)
hex[3] (SEG3G, SEG3F, SEG3E, SEG3D, SEG3C, SEG3B, SEG3A)
hex[4] (SEG4G, SEG4F, SEG4E, SEG4D, SEG4C, SEG4B, SEG4A)
hex[5] (SEG5G, SEG5F, SEG5E, SEG5D, SEG5C, SEG5B, SEG5A)
